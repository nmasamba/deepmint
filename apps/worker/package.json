{
  "name": "@deepmint/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "npx inngest-cli@latest dev -u http://localhost:3000/api/inngest",
    "check": "tsc --noEmit",
    "backfill": "tsx scripts/backfill.ts",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@deepmint/api": "workspace:*",
    "@deepmint/db": "workspace:*",
    "@deepmint/ingestion": "workspace:*",
    "@deepmint/scoring": "workspace:*",
    "@deepmint/shared": "workspace:*",
    "inngest": "^4.1.0",
    "resend": "^6.10.0"
  },
  "devDependencies": {
    "@deepmint/tsconfig": "workspace:*",
    "tsx": "^4.19.0",
    "typescript": "^5.8.2"
  }
}
