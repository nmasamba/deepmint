# =============================================================================
# Deepmint env template: every variable the code reads, grouped by service.
#
# No tool reads a root `.env`. Copy what you need into these files:
#   apps/web/.env.local  Next.js dev server (`pnpm --filter @deepmint/web dev`).
#                        All app vars. The Inngest worker functions run inside
#                        Next at /api/inngest, so their vars go here too.
#   packages/db/.env     drizzle-kit (db:migrate/generate/push/studio). Needs
#                        DATABASE_URL only. drizzle-kit reads `.env`, not
#                        `.env.local`.
#   .env.local (root)    vitest in every package: HF_API_KEY for the live LLM
#                        tests, TEST_* for the web integration tests.
# db:seed and the backfill CLI read no file: export their vars in the shell.
# Root `pnpm dev`/`pnpm test` run through Turbo's strict env mode: app vars
# exported in the shell (other than NEXT_PUBLIC_* for the web app) are
# filtered out, and .env.local edits do not invalidate cached test results.
# Prefer `pnpm --filter <pkg> <script>`.
#
# All of these files are gitignored; never commit real values. Production
# values live in Vercel env (project deepmint-web-7ald), and changes need a
# redeploy. Last recorded production status: docs/EXTERNAL_KEYS.md.
#
# Commented-out lines are optional overrides, inert, or not read at all. Leave
# them commented rather than empty: several reads use `??`, where "" is not
# the same as unset.
# =============================================================================

# --- Database: Postgres -------------------------------------------------------
# Required for anything that touches data (the db client throws on its first
# query; `next build` still works). This value matches docker-compose: Postgres
# 16 on host port 5433. Never point a local DATABASE_URL at production
# (Supabase), and never run db:seed against it: the seed writes fictional
# Guides and 100 fake claims into the append-only ledger.
DATABASE_URL=postgresql://deepmint:deepmint@localhost:5433/deepmint

# --- Clerk: auth --------------------------------------------------------------
# Required. Read by @clerk/nextjs; CI passes both to `next build`. Production
# currently runs on a Clerk development instance (pk_test_ keys).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional. Read only by POST /api/webhooks/clerk (user.created); unset, that
# route returns 500. Players are still created by the tRPC self-heal on a
# signed-in user's first tRPC request.
CLERK_WEBHOOK_SECRET=
# Optional. Sends auth to the in-app pages; unset, Clerk uses its hosted pages.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Not read: Clerk 7 reads NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL,
# ..._SIGN_IN_FORCE_REDIRECT_URL and the SIGN_UP equivalents instead. Users
# still reach /dashboard because the middleware redirects a signed-in `/` there.
# NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
# NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# --- App ----------------------------------------------------------------------
# Optional. Sets metadataBase (apps/web/app/layout.tsx); unset, it defaults to
# https://deepmint.app, which is not the production host. No field it resolves
# (Open Graph or Twitter URLs and images, alternates) is set today, so it has
# no visible effect yet. An empty value throws (`new URL("")`).
# NEXT_PUBLIC_APP_URL=https://www.deepmint.ai
# Set by the platform; do not set by hand:
#   VERCEL_URL  server-side tRPC base URL (unset: http://localhost:3000)
#   NODE_ENV    `development` disables the Serwist service worker

# --- Inngest: background jobs (15 functions served at /api/inngest) ----------
# Required in production. Without INNGEST_DEV the SDK runs in cloud mode:
# inngest.send() throws with no event key, and /api/inngest rejects Inngest's
# calls with no signing key. Locally, leave both empty and set INNGEST_DEV=1;
# production keys here without INNGEST_DEV would send local events to
# production Inngest.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Production: the Vercel<>Inngest integration provisions these prefixed names.
# apps/web/app/api/inngest/inngest-env.ts and apps/worker/inngest.ts copy them
# onto the two names above when those are unset. The tRPC routers' own Inngest
# clients (claims, social, instruments) do not get that mapping.
# INNGEST_WORKFLOW_INNGEST_EVENT_KEY=
# INNGEST_WORKFLOW_INNGEST_SIGNING_KEY=
# Local dev only. "1" puts the SDK in dev mode against the Inngest dev server
# on http://localhost:8288. Start it with:
#   npx inngest-cli@latest dev -u http://localhost:3000/api/inngest
# The backfill CLI reads no file: run `INNGEST_DEV=1 pnpm --filter
# @deepmint/worker backfill ./archive.json`.
# INNGEST_DEV=1

# --- Market data: Polygon.io (Massive.com SDK) --------------------------------
# Required in production. Unset: fixed dev prices for the 7 Mag-7 tickers only
# (other tickers throw), empty historical bars (so backfill-prices deactivates
# newly added instruments), fixed default regime indicators, and an empty news
# lane. Never run a keyless deploy against a shared database: the fixed prices
# would land permanently in claims (append-only) and outcomes. All calls share
# a 12.5 s per-process throttle sized for the 5 req/min plan; it is not a
# queue, so concurrent calls can fire together.
POLYGON_API_KEY=
# Optional, off by default. Only "1" adds the Polygon news ("Wall Street
# ratings") lane to the weekday ingest-sources cron. The lane is parked.
# INGEST_POLYGON_NEWS=1

# --- LLM extraction: Hugging Face router --------------------------------------
# Required for extraction (OpenAI SDK pointed at
# https://router.huggingface.co/v1). Unset: every extraction throws and the
# event keeps no claims (failed events are never re-driven). In the root
# .env.local it also enables 6 live LLM tests in packages/ingestion (real HF
# calls).
HF_API_KEY=
# Optional emergency overrides; leave unset. Defaults:
# openai/gpt-oss-120b:fastest, then the different fallback model
# meta-llama/Llama-3.3-70B-Instruct:fastest. ":fastest" lets the router fail
# over between providers; a pinned "model:provider" disables that. An empty
# LLM_MODEL means the default; LLM_MODEL_FALLBACK="" disables the fallback.
# LLM_MODEL=openai/gpt-oss-120b:fastest
# LLM_MODEL_FALLBACK=meta-llama/Llama-3.3-70B-Instruct:fastest

# --- Upstash Redis (REST) -----------------------------------------------------
# Optional; set both or neither. Unset: no rate limits (claims.submit 10/h per
# entity, broker sync 1/h per entity, REST v1 and MCP per key per minute,
# default 60), no follower-count cache and no 1-hour regime-indicator cache.
# That cache is the only Polygon cache: prices are never cached.
# X-RateLimit-* headers are sent either way.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Not read by app code. The docker-compose Redis 7 container is unused because
# all Redis access is Upstash REST. mcp-handler reads REDIS_URL only for its
# SSE transport, which this app never reaches.
# REDIS_URL=redis://localhost:6379

# --- Resend: daily digest email -----------------------------------------------
# Optional. Unset: the daily-digest cron (12:00 UTC, Mon-Fri) skips. Even when
# set, mail goes from digest@deepmint.app to the placeholder
# user+<clerkUserId>@deepmint.app, so it reaches no real user.
RESEND_API_KEY=

# --- SnapTrade: read-only broker verification ---------------------------------
# Optional; set both or neither. Unset: Settings says broker verification is
# not configured, and the broker-sync cron returns snaptrade-not-configured.
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=

# --- Cloudflare R2: snapshot storage (INERT) ----------------------------------
# No live code calls R2, so events.snapshot_path is always null and setting
# these changes nothing. Read only by packages/ingestion/src/r2.ts. Defaults:
# bucket deepmint-snapshots, public URL https://snapshots.deepmint.com.
# CLOUDFLARE_R2_ACCOUNT_ID=
# CLOUDFLARE_R2_ACCESS_KEY_ID=
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# CLOUDFLARE_R2_BUCKET=deepmint-snapshots
# CLOUDFLARE_R2_PUBLIC_URL=

# --- Sentry: error tracking (INERT) -------------------------------------------
# Setting the DSN does nothing: there is no instrumentation.ts and no
# withSentryConfig, so apps/web/sentry.*.config.ts never load. Enabling Sentry
# needs code changes. SENTRY_AUTH_TOKEN is read by nothing.
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=

# --- Tests: root .env.local only ----------------------------------------------
# The apps/web integration suite (4 files) skips unless TEST_API_KEY is set.
# It also needs a running server and a database. Use a dm_live_ key minted at
# /admin/api-keys (admins only) with the 3 read scopes.
# TEST_API_KEY=
# Default http://localhost:3000.
# TEST_BASE_URL=http://localhost:3000
# Default demo-guide, which no seed creates. Use a seeded slug.
# TEST_ENTITY_SLUG=sarah-chen
